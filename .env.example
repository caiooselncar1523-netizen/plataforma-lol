# Application
APP_ENV=development

# Riot Games API
RIOT_API_KEY=
RIOT_REQUEST_INTERVAL_MS=1200
RIOT_COLLECTION_MAX_PLAYERS=40
RIOT_COLLECTION_MATCHES_PER_PLAYER=10
RIOT_MIN_CHAMPION_GAMES=50

# Persistence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ahriademia
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ahriademia?schema=public

# Analysis provider
ANTHROPIC_API_KEY=
